{%- liquid
  assign gbi_fabric_cost = product.metafields.custom.fabric_cost_per_metre.value
  if gbi_fabric_cost == blank
    for field in product.metafields.custom
      assign gbi_key = field[0]
      if gbi_key contains 'fabric_cost' and field[1].value != blank
        assign gbi_fabric_cost = field[1].value
        break
      endif
    endfor
  endif
-%}

{% if gbi_fabric_cost != blank %}
  <div
    class="gbi-cushion-calculator bg-light p-23"
    style="padding: 20px; background: #f8f9fa; border-radius: 8px; margin-bottom: 20px;"
  >
    {% comment %} Metafield for Fabric Cost {% endcomment %}
    <input type="hidden" id="gbi-cushion-meta-metre-cost" value="{{ gbi_fabric_cost }}">

    {% comment %} Rates, editable from the theme editor {% endcomment %}
    <input type="hidden" id="gbi-cushion-multiplier" value="{{ block.settings.fabric_multiplier | default: 0.6 }}">
    <input type="hidden" id="gbi-cushion-labour" value="{{ block.settings.labour | default: 25.00 }}">
    <input type="hidden" id="gbi-cushion-postage" value="{{ block.settings.postage | default: 10.00 }}">
    <input type="hidden" id="gbi-cushion-piped-extra" value="{{ block.settings.piped_extra | default: 0 }}">

    {% render 'gbi-variant-data' %}

    <div class="price_option_section" style="padding-top: 5px;">
      <button
        type="button"
        id="gbi-cushion-calculate-btn"
        class="button button--primary"
        style="background: #000; color: #fff; padding: 12px 20px; border: none; cursor: pointer; font-weight: bold; border-radius: 4px; width: 100%;"
      >
        Calculate Price
      </button>

      <div class="second_option_section" style="margin-top: 15px; text-align: center;">
        <div class="price price--large">
          <span id="gbi-cushion-display-price" style="font-size: 24px; font-weight: bold; color: #333;">{{ 0 | money }}</span>
        </div>
        {% if block.settings.show_breakdown %}
          <div id="gbi-cushion-price-breakdown" style="margin-top: 8px; font-size: 13px; line-height: 1.5; color: #666;"></div>
        {% endif %}
      </div>
    </div>

    <script src="{{ 'cushion-calculator.js' | asset_url }}" defer></script>
  </div>
{% endif %}

{% schema %}
{
  "name": "GBI Cushion Calculator",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "fabric_multiplier",
      "label": "Fabric multiplier",
      "default": "0.6",
      "info": "Fabric cost per metre x this value. 0.6 is the rate for a 45x45 cushion."
    },
    {
      "type": "number",
      "id": "labour",
      "label": "Labour cost",
      "default": 25
    },
    {
      "type": "number",
      "id": "postage",
      "label": "Delivery / postage charge",
      "default": 10
    },
    {
      "type": "number",
      "id": "piped_extra",
      "label": "Piped edging extra cost",
      "default": 0,
      "info": "Added when the Edging option is Piped. Leave at 0 until the client confirms the rate."
    },
    {
      "type": "checkbox",
      "id": "show_breakdown",
      "label": "Show price breakdown under the price",
      "default": false
    }
  ]
}
{% endschema %}
